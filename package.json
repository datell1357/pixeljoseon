{
  "name": "lantern-road",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "등불길 — 쿼터뷰 실시간 액션 RPG",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "maps": "tsx tools/genmaps.ts",
    "bake": "node tools/bake/run.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.26",
    "@colyseus/schema": "^5.0.44",
    "@colyseus/ws-transport": "^0.18.4",
    "colyseus": "^0.18.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.9",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "galmuri": "^2.40.3",
    "phaser": "^4.2.1",
    "playwright": "^1.64.1",
    "preact": "^11.1.1",
    "pretendard": "^1.3.9",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
